rules_version = '2';

// Access control for the baby-tracking app (KAN-134: multi-caregiver).
//
// Baby data lives in a shared top-level collection so it can be owned and
// edited by multiple caregivers:
//
//   babies/{babyId}                       (name, birthDate, sex, ownerUid,
//                                          members{uid:role}, memberUids[])
//   babies/{babyId}/feedings/{eventId}
//   babies/{babyId}/diapers/{eventId}
//   babies/{babyId}/growth/{eventId}
//   babies/{babyId}/invites/{email}       (pending caregiver invitations)
//
// A caregiver may touch a baby (and its subcollections) only if their uid is
// in that baby's memberUids. Joining is allowed only for someone holding a
// matching invite, and only to add themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function babyData(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data;
    }

    // Membership of a baby the rule is *reading directly* — uses the doc's own
    // data so list queries (where memberUids array-contains uid) are provable.
    function isMemberOf(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    // Membership of a *parent* baby, for subcollection/invite rules where the
    // document being read isn't the baby itself. Costs one get() per query.
    function isMember(babyId) {
      return signedIn() && request.auth.uid in babyData(babyId).memberUids;
    }

    // Notification preferences (KAN-167): quiet hours and the server-side
    // reminder switch. Strictly per-user — the doc id is the uid — and read
    // by the reminder Cloud Function via the Admin SDK.
    match /notificationPrefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Per-device push tokens (KAN-156): a user manages only their own; the
    // reminder Cloud Function reads them all via the Admin SDK.
    match /fcmTokens/{token} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /babies/{babyId} {
      allow read: if isMemberOf(resource.data);

      // Create: the creator must make themselves the sole owner.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner';

      // Members may edit the baby; a non-member may accept an invite by
      // adding only themselves (see below).
      allow update: if isMemberOf(resource.data) || isAcceptingInvite(babyId);

      // Only the owner may delete the profile.
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // A signed-in, invited user adds exactly themselves to the member
      // lists, keeps the existing members, and leaves ownership unchanged.
      function isAcceptingInvite(babyId) {
        let existing = resource.data;
        let incoming = request.resource.data;
        return signedIn()
          && !(request.auth.uid in existing.memberUids)
          && (request.auth.uid in incoming.memberUids)
          && incoming.memberUids.size() == existing.memberUids.size() + 1
          && existing.memberUids.hasOnly(incoming.memberUids)
          && incoming.ownerUid == existing.ownerUid
          && exists(/databases/$(database)/documents/babies/$(babyId)/invites/$(request.auth.token.email));
      }

      // Invites: readable by members and by the invited email; only members
      // create/delete them.
      match /invites/{email} {
        // Members see all invites; an invitee sees their own. Matching on the
        // stored email field (not the doc id) keeps the collection-group
        // "invites where email == me" query provable.
        allow read: if isMember(babyId)
          || (signedIn() && resource.data.email == request.auth.token.email);
        allow create: if isMember(babyId);
        // Members revoke; the invitee deletes their own on accept/decline.
        allow delete: if isMember(babyId)
          || (signedIn() && resource.data.email == request.auth.token.email);
      }

      // Event subcollections: full access to members.
      match /{sub}/{docId} {
        allow read, write: if isMember(babyId);
      }
    }
  }
}
