rules_version = '2';

// Access control for the baby-tracking app (KAN-134: multi-caregiver).
//
// Baby data lives in a shared top-level collection so it can be owned and
// edited by multiple caregivers:
//
//   babies/{babyId}                       (name, birthDate, sex, ownerUid,
//                                          members{uid:role}, memberUids[])
//   babies/{babyId}/feedings/{eventId}
//   babies/{babyId}/diapers/{eventId}
//   babies/{babyId}/growth/{eventId}
//   babies/{babyId}/pumps/{eventId}
//   babies/{babyId}/appointments/{eventId}
//   babies/{babyId}/invites/{email}       (pending caregiver invitations)
//
// A caregiver may touch a baby (and its subcollections) only if their uid is
// in that baby's memberUids. Joining is allowed only for someone holding a
// matching invite, and only to add themselves.
//
// That list is exhaustive, and deliberately so — see the event subcollection
// rules below. Adding a subcollection to the app now means adding it here as
// well, which is a rules deploy before the feature can ship.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function babyData(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data;
    }

    // Membership of a baby the rule is *reading directly* — uses the doc's own
    // data so list queries (where memberUids array-contains uid) are provable.
    function isMemberOf(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    // Membership of a *parent* baby, for subcollection/invite rules where the
    // document being read isn't the baby itself. Costs one get() per query.
    function isMember(babyId) {
      return signedIn() && request.auth.uid in babyData(babyId).memberUids;
    }

    // Ownership of a *parent* baby, for the invite rules below. The roster is
    // the owner's to manage, so growing it is theirs too.
    function isOwnerOfBaby(babyId) {
      return signedIn() && babyData(babyId).ownerUid == request.auth.uid;
    }

    // Who may start a household.
    //
    // The app is private. Anyone with a Google account can sign in — that is
    // Firebase Auth's business and not something rules can prevent — but
    // signing in alone gets you nothing: you cannot read a baby you are not a
    // member of, and without an entry here you cannot create one either.
    //
    // Deliberately keyed by lowercased email rather than uid, so someone can
    // be allowed before they have ever signed in. Matches the `invites`
    // convention.
    //
    // Readable only for your own address. `if signedIn()` alone would let any
    // account probe whether a given email has access, which is a membership
    // list nobody needs to be able to enumerate.
    match /allowedUsers/{email} {
      allow get: if signedIn() && email == myEmail();
    }

    // Lowercased, because the document id has to be unambiguous: providers
    // are not required to normalise case, and the client looks the same
    // document up the same way. If these two disagreed, the app would offer a
    // household that the rules then refused to create.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function mayStartHousehold() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(myEmail()));
    }

    // Notification preferences (KAN-167): quiet hours and the server-side
    // reminder switch. Strictly per-user — the doc id is the uid — and read
    // by the reminder Cloud Function via the Admin SDK.
    match /notificationPrefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Per-device push tokens (KAN-156): a user manages only their own; the
    // reminder Cloud Function reads them all via the Admin SDK.
    match /fcmTokens/{token} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /babies/{babyId} {
      allow read: if isMemberOf(resource.data);

      // Create: an allowed caregiver, making themselves the sole owner.
      //
      // The allowlist gates *starting a household*, not joining one. Someone
      // invited as a caregiver accepts by updating an existing baby, which is
      // the rule below — so an invitee never needs an entry, and the two
      // mechanisms do not overlap.
      allow create: if mayStartHousehold()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner';

      // Members edit the profile; the owner manages the roster; anyone can
      // show themselves out. An unconstrained member update would let an
      // invited caregiver evict the owner or rewrite ownerUid to themselves —
      // and the owner-only delete below would then be theirs too.
      allow update: if isAcceptingInvite(babyId)
        || (isMemberOf(resource.data)
            && ownerUnchanged()
            && (rosterUnchanged() || isLeaving()))
        || (isOwnerOf(resource.data) && ownerUnchanged());

      // Only the owner may delete the profile.
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      function isOwnerOf(data) {
        return signedIn() && data.ownerUid == request.auth.uid;
      }

      // There is no hand-over feature, so any change to ownerUid is someone
      // rewriting it rather than a transfer the app offers.
      function ownerUnchanged() {
        return request.resource.data.ownerUid == resource.data.ownerUid;
      }

      // The caregiver roster is untouched — an ordinary profile edit.
      function rosterUnchanged() {
        return request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.members == resource.data.members;
      }

      // Removing exactly yourself: one uid fewer, none added, and the one
      // that went is the caller's own.
      function isLeaving() {
        return !(request.auth.uid in request.resource.data.memberUids)
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.memberUids.size()
              == resource.data.memberUids.size() - 1
          && request.resource.data.memberUids.hasOnly(resource.data.memberUids);
      }

      // A signed-in, invited user adds exactly themselves to the member
      // lists, keeps the existing members, and leaves ownership unchanged.
      function isAcceptingInvite(babyId) {
        let existing = resource.data;
        let incoming = request.resource.data;
        return signedIn()
          && !(request.auth.uid in existing.memberUids)
          && (request.auth.uid in incoming.memberUids)
          && incoming.memberUids.size() == existing.memberUids.size() + 1
          && existing.memberUids.hasOnly(incoming.memberUids)
          && incoming.ownerUid == existing.ownerUid
          && exists(/databases/$(database)/documents/babies/$(babyId)/invites/$(request.auth.token.email));
      }

      // Invites: readable by members and by the invited email; only the owner
      // issues or revokes them.
      match /invites/{email} {
        // Members see all invites; an invitee sees their own. Matching on the
        // stored email field (not the doc id) keeps the collection-group
        // "invites where email == me" query provable.
        allow read: if isMember(babyId)
          || (signedIn() && resource.data.email == request.auth.token.email);

        // Owner-only, matching the UI, which offers "Add caregiver" and
        // revoke to the owner alone. These were member-wide while the UI was
        // the only thing enforcing it — so any caregiver could have grown the
        // roster straight through the API, which is the same authority the
        // update rules deliberately withhold from them.
        allow create: if isOwnerOfBaby(babyId);
        // The owner revokes; the invitee deletes their own on accept/decline.
        allow delete: if isOwnerOfBaby(babyId)
          || (signedIn() && resource.data.email == request.auth.token.email);
      }

      // --- Event subcollections (#22) --------------------------------------
      //
      // Named one at a time rather than matched by wildcard. The wildcard let
      // a member create any collection they liked under a baby, and it also
      // matched `invites` — and because Firestore allows an operation if
      // *any* rule allows it, a blanket member-write here silently overrode
      // the narrower invite rules above, whatever they said. Naming the five
      // the app actually uses closes both at once.
      //
      // The realistic threat is not a malicious co-parent. It is that these
      // rules are the only thing between a bug and the database: a loop that
      // writes every frame, a bad migration, a mistyped field. All of it is
      // billed, and all of it is permanent.

      match /feedings/{docId} {
        allow read, delete: if isMember(babyId);
        allow create: if isMember(babyId) && authored() && feedingShape();
        allow update: if isMember(babyId) && reauthored() && feedingShape();

        function feedingShape() {
          let d = request.resource.data;
          return d.type in ['breast', 'bottle', 'solids']
            && d.startTime is timestamp
            && count(d.get('durationMinutes', null))
            && amount(d.get('amountMl', null))
            && side(d.get('side', null))
            && text(d.get('notes', null))
            && d.get('isSnack', false) is bool;
        }
      }

      match /diapers/{docId} {
        allow read, delete: if isMember(babyId);
        allow create: if isMember(babyId) && authored() && diaperShape();
        allow update: if isMember(babyId) && reauthored() && diaperShape();

        function diaperShape() {
          let d = request.resource.data;
          return d.type in ['wet', 'dirty', 'both']
            && d.time is timestamp
            && optional(d.get('poopSize', null), ['small', 'medium', 'large'])
            && text(d.get('notes', null));
        }
      }

      match /growth/{docId} {
        allow read, delete: if isMember(babyId);
        allow create: if isMember(babyId) && authored() && growthShape();
        allow update: if isMember(babyId) && reauthored() && growthShape();

        function growthShape() {
          let d = request.resource.data;
          return d.date is timestamp
            && amount(d.get('weightKg', null))
            && amount(d.get('heightCm', null))
            && amount(d.get('headCm', null));
        }
      }

      // `pumps`, not `pumping`: the collection is named for what is stored,
      // and getting this wrong would deny every pump the app writes.
      match /pumps/{docId} {
        allow read, delete: if isMember(babyId);
        allow create: if isMember(babyId) && authored() && pumpShape();
        allow update: if isMember(babyId) && reauthored() && pumpShape();

        function pumpShape() {
          let d = request.resource.data;
          return d.time is timestamp
            && count(d.get('durationMinutes', null))
            && amount(d.get('amountMl', null))
            && side(d.get('side', null))
            && text(d.get('notes', null));
        }
      }

      match /appointments/{docId} {
        allow read, delete: if isMember(babyId);
        allow create: if isMember(babyId) && authored() && appointmentShape();
        allow update: if isMember(babyId) && reauthored() && appointmentShape();

        function appointmentShape() {
          let d = request.resource.data;
          return d.at is timestamp
            && d.kind in ['checkup', 'vaccination', 'specialist', 'dental',
                          'other']
            && (d.get('completedAt', null) == null || d.completedAt is timestamp)
            && text(d.get('title', null))
            && text(d.get('provider', null))
            && text(d.get('location', null))
            && text(d.get('notes', null));
        }
      }

      // --- Shared field checks ---------------------------------------------
      //
      // Every optional field is written as an explicit null rather than
      // omitted — that is what `toMap()` produces — so "absent" and "null"
      // both have to pass. `get` with a null default covers a document
      // written by an older client that predates the field.

      // Who logged it. Stamped client-side and, until now, never checked, so
      // a caregiver could record an entry under someone else's name. Nothing
      // displays it yet, but it is stored as fact and was not one.
      function authored() {
        return request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
      }

      // An edit may not rewrite who created the entry, and must own up to
      // who changed it.
      function reauthored() {
        return request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }

      // Millilitres, kilograms, centimetres. Negative is not a quantity.
      function amount(v) {
        return v == null || (v is number && v >= 0);
      }

      // Whole minutes.
      function count(v) {
        return v == null || (v is int && v >= 0);
      }

      function side(v) {
        return optional(v, ['left', 'right', 'both']);
      }

      function optional(v, allowed) {
        return v == null || v in allowed;
      }

      // Free text. The app's own fields are a line or two; the cap is there
      // so a bug cannot quietly write a megabyte per entry.
      function text(v) {
        return v == null || (v is string && v.size() <= 1000);
      }
    }
  }
}
